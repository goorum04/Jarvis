# Copia este archivo a .env y rellena los valores

# API key de Anthropic (Claude)
CLAUDE_API_KEY=sk-ant-...

# API key de OpenAI (GPT-4) — opcional
OPENAI_API_KEY=sk-...

# RUTA al archivo JSON de credenciales de Google Cloud — opcional
# Ejemplo: C:\Users\TuUsuario\credentials\google-cloud.json
GOOGLE_CLOUD_CREDENTIALS_PATH=
