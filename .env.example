# ── CEREBRO ─────────────────────────────────────────────────────────────────
# API key de Anthropic (Claude) — obligatorio
CLAUDE_API_KEY=
# Modelo que hace de "cerebro"
JARVIS_MODEL=claude-opus-5-5
# Cuánto piensa antes de responder: low = responde antes (recomendado para
# hablar en el coche); medium / high = más reflexivo en peticiones complejas
JARVIS_EFFORT=low
# Modelo barato que filtra qué correos merecen un aviso
CLASSIFIER_MODEL=claude-haiku-5-5

# Nombre con el que JARVIS se dirige a su dueño
OWNER_NAME=Nacho

# Token que deben mandar el iPhone, el panel y cualquier cliente externo
# (Authorization: Bearer <este token>). Obligatorio en cuanto el backend
# se expone a internet — genera uno largo y aleatorio.
JARVIS_API_TOKEN=
# Dirección pública por la que entran el iPhone y la tablet. La rellena
# instalar.command con la de Tailscale; con dominio propio, ponla a mano.
PUBLIC_URL=

# ── PROTECCIÓN ──────────────────────────────────────────────────────────────
# Tope de gasto diario en IA (dólares, aproximado). Al llegar, JARVIS avisa y
# deja de usar la IA hasta el día siguiente.
DAILY_BUDGET_USD=10
# Caracteres de voz ElevenLabs al día; pasado el límite responde con texto
# (el iPhone lo lee con la voz de Siri)
DAILY_VOICE_CHARS=30000
# Más preguntas que estas en un minuto se rechazan (bucles o abuso del token)
REQUESTS_PER_MINUTE=20

# ── VOZ ─────────────────────────────────────────────────────────────────────
# API key de ElevenLabs — obtener en elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ID de la voz (por defecto, la voz premade "George"). Para una voz propia
# de JARVIS, diséñala en ElevenLabs (CONFIGURAR_JARVIS.md, paso 10) y pega aquí su ID.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 = mínima latencia (recomendado para conversación);
# eleven_multilingual_v2 = algo más de calidad, pero más lento
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ── LUGARES ─────────────────────────────────────────────────────────────────
TIMEZONE=Europe/Madrid
# Casa: para el tiempo (Open-Meteo, sin API key) y como origen de las rutas
# cuando el iPhone no ha mandado su posición
HOME_LAT=
HOME_LON=
HOME_CITY=
HOME_COUNTRY=ES
HOME_ADDRESS=
WORK_ADDRESS=

# ── NAVEGACIÓN Y TRÁFICO ────────────────────────────────────────────────────
# Google Cloud Console → activar "Routes API" → crear clave. De pago por uso.
GOOGLE_MAPS_API_KEY=
# App que se abre al navegar: apple, google o waze
NAV_APP=apple
# Margen extra al avisar de la hora de salir hacia una cita (minutos)
LEAVE_BUFFER_MINUTES=10

# ── AVISOS AL IPHONE ────────────────────────────────────────────────────────
# Pushcut (recomendado): Ajustes de la app Pushcut → API → "Secret", y el
# nombre de la notificación que hayas creado en la app
PUSHCUT_SECRET=
PUSHCUT_NOTIFICATION=JARVIS
# ntfy (alternativa gratuita, solo notificación): un nombre de tema largo
# e imposible de adivinar
NTFY_TOPIC=
# Avisar del correo importante (1 = sí, 0 = no)
EMAIL_ALERTS=1
# Aviso de gasolina baja por debajo de este porcentaje
FUEL_ALERT_PERCENT=15
# Rueda baja: si está esta diferencia (bar) por debajo de la más alta...
TIRE_DIFF_BAR=0.3
# ...o por debajo de este mínimo (opcional; mira la etiqueta del marco de la puerta)
TIRE_MIN_BAR=
# Informes al iPhone ("HH:MM"; vacío para desactivar)
BRIEFING_TIME=08:00
STORE_CLOSE_TIME=21:30

# ── IPHONE ──────────────────────────────────────────────────────────────────
# Atajos del iPhone que JARVIS puede lanzar por voz, separados por comas
# (casa, música, escenas...). Solo estos; cualquier otro se rechaza.
IPHONE_SHORTCUTS=

# ── GMAIL Y GOOGLE CALENDAR ─────────────────────────────────────────────────
# No van aquí: se conectan con google_credentials.json +
# `python autorizar_google.py` (ver CONFIGURAR_JARVIS.md).

# ── MERCEDES ────────────────────────────────────────────────────────────────
# Vehicle Status API de Mercedes-Benz (developer.mercedes-benz.com) para el
# C63: combustible, autonomía y cierre. Vacío = JARVIS no habla del coche.
MERCEDES_CLIENT_ID=
MERCEDES_CLIENT_SECRET=
MERCEDES_REFRESH_TOKEN=
MERCEDES_VIN=

# ── TIENDA ONLINE ───────────────────────────────────────────────────────────
# shopify o woocommerce
STORE_PLATFORM=
# Avisos: pedido grande (a partir de este importe), pedido pagado sin enviar
# tras estos días, y producto con estas unidades o menos
BIG_ORDER_AMOUNT=500
STALE_ORDER_DAYS=2
LOW_STOCK_THRESHOLD=3
# Shopify: Ajustes → Apps → Desarrollar apps → app con permisos read_orders y read_products
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-07
# WooCommerce: WooCommerce → Ajustes → Avanzado → API REST → clave de "Lectura"
WOO_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# ── DOCUMENTOS (RAG, opcional) ──────────────────────────────────────────────
# Solo para los embeddings de los documentos de docs/
OPENAI_API_KEY=
