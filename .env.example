# API key de Anthropic (Claude) — obligatorio
CLAUDE_API_KEY=sk-ant-...
# Modelo de Claude que hace de "cerebro"
CLAUDE_MODEL=claude-opus-5

# Nombre con el que JARVIS se dirige a su dueño
OWNER_NAME=Nacho

# API key de OpenAI — opcional, solo se usa para los embeddings del RAG
OPENAI_API_KEY=sk-...

# API key de ElevenLabs — obtener en elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_...
# ID de la voz a usar (por defecto, la voz premade "George"). Cambialo si
# quieres otra voz de tu cuenta de ElevenLabs.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 = mínima latencia (recomendado para conversación);
# eleven_multilingual_v2 = algo más de calidad, pero más lento
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Zona horaria para el scheduler de recordatorios
TIMEZONE=Europe/Madrid

# Token que deben mandar los Atajos de Siri y cualquier cliente externo
# (Authorization: Bearer <este token>). Obligatorio en cuanto el backend
# se expone a internet — genera uno largo y aleatorio.
JARVIS_API_TOKEN=

# Ubicación de referencia para el clima del saludo de CarPlay (Open-Meteo,
# no requiere API key)
HOME_LAT=
HOME_LON=

# Credenciales de la Vehicle Status API de Mercedes-Benz
# (developer.mercedes-benz.com) para el C63 — combustible, autonomía y
# si está cerrado. Deja vacío si todavía no las tienes: el saludo de
# CarPlay simplemente omite esa parte.
MERCEDES_CLIENT_ID=
MERCEDES_CLIENT_SECRET=
MERCEDES_REFRESH_TOKEN=
MERCEDES_VIN=
