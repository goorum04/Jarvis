# Copia este archivo a .env y rellena los valores

# API key de Anthropic (Claude) — obligatorio
CLAUDE_API_KEY=sk-ant-...

# API key de OpenAI (GPT-4) — opcional, solo si usas el botón GPT-4
OPENAI_API_KEY=sk-...

# API key de ElevenLabs (voz de JARVIS) — obtener en elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_...
